rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Profile photos live at avatars/{uid} — the object name is the owner's
    // uid (see services/users.ts uploadProfilePhoto). Anyone signed in may
    // read them (friends render each other's avatars); only the owner may
    // upload, replace, or delete their own, and uploads must be a
    // reasonably-sized image.
    match /avatars/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && (request.resource == null
            || (request.resource.contentType.matches('image/.*')
                && request.resource.size < 5 * 1024 * 1024));
    }

    // Post photos live at posts/{uid}/{postId}/{index} — the {uid} segment is
    // the post owner (see services/posts.ts uploadPostPhotos). Anyone signed in
    // may read them (friends view each other's posts); only the owner may write,
    // and uploads must be a reasonably-sized image.
    match /posts/{uid}/{postId}/{file} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && (request.resource == null
            || (request.resource.contentType.matches('image/.*')
                && request.resource.size < 5 * 1024 * 1024));
    }
  }
}
